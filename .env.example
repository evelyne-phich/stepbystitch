# ==============================================================================
# StepByStitch: Configuration des variables d'environnement
# ==============================================================================

# URL publique de votre projet Supabase (ex: https://xyzcompany.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Clé anonyme publique Supabase (Safe for browser)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Clé secrète de service Supabase (UNIQUEMENT pour le backend / scripts d'admin)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# URL canonique de votre site pour le SEO et les métadonnées (en local: http://localhost:3000)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Clé API IA pour l'OCR, la découpe des patrons et la traduction crochet
# Compatible Claude (Anthropic) ou Gemini
ANTHROPIC_API_KEY=your-anthropic-api-key
GEMINI_API_KEY=your-gemini-api-key
