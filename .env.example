# ==============================================================================
# StepByStitch: Environment Variables Configuration
# ==============================================================================

# Public URL of your Supabase project (e.g. https://xyzcompany.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Supabase Public Anonymous Key (safe for browser exposure)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Supabase Secret Service Role Key (ONLY for backend / administrative jobs)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Canonical site URL for SEO and metadata (local default: http://localhost:3000)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Google Gemini AI API Configuration
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-3.7-flash
